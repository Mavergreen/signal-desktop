#!/bin/sh
# Materialize "Linux Signal Desktop.app" from the preset conf. Runs as root at install time with no Docker,
# so --no-icon builds the .app structure now (generic icon); the container image + the real Signal
# icon resolve on first launch, as the user.
set -eu
CONF="/Library/Application Support/Mavergreen/Porthole/presets/signal-desktop.conf"
PORTHOLE=/usr/local/bin/porthole
[ -x "$PORTHOLE" ] || PORTHOLE="/Applications/Porthole.app/Contents/Resources/engine/bin/porthole"
PORTHOLE_MATERIALIZE_NO_ICON=1 "$PORTHOLE" materialize "$CONF" --apps-dir /Applications
exit 0
