{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Mavergreen/shipyard"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Signal-Desktop stable releases into UPSTREAM_VERSION (the release name; the container floats to latest at first launch).",
      "managerFilePatterns": ["/^UPSTREAM_VERSION$/"],
      "matchStrings": ["^(?<currentValue>.+?)\\s*$"],
      "depNameTemplate": "signalapp/Signal-Desktop",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "clang22, the compiler the Sparkle updater is built with (build/build-updater.sh); one bare release tag. A bump rebuilds the updater in CI; it ships with the next release.",
      "managerFilePatterns": ["/^components/clang22/version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "Mavergreen/clang-22",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mavericks\\.(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["signalapp/Signal-Desktop"],
      "allowedVersions": "!/-beta/"
    }
  ]
}
